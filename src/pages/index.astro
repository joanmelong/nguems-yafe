---
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import NewsBanner from '../components/NewsBanner.astro';
import QuiSommesNous from '../components/QuiSommesNous.astro';
import ProductExplorer from '../components/ProductExplorer.astro';
import Temoignages from '../components/Temoignages.astro';
import PromoteLocation from '../components/PromoteLocation.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import Layout from '../layouts/Layout.astro';
import {
  contact,
  productRanges,
  products,
  siteMeta,
} from '../data/site';
---

<Layout title={siteMeta.title} description={siteMeta.description}>
  <Header />
  <main>
    <Hero />
    <NewsBanner />
    <QuiSommesNous />
    <ProductExplorer
      ranges={productRanges}
      products={products}
      whatsappPhone={contact.phone}
    />
    <Temoignages />
    <PromoteLocation />
    <Contact />
  </main>
  <Footer />
  <FloatingWhatsApp />
</Layout>
