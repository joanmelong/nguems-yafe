---
import { Image } from 'astro:assets';
import { promoteInfo } from '../data/site';

const marqueeImages = [...promoteInfo.gallery, ...promoteInfo.gallery];
---

<section class="section promote-section" id="promote" aria-labelledby="promote-title">
  <div class="container promote-grid">
    <div class="promote-panel">
      <span class="section-kicker">PROMOTE 2026</span>
      <h2 class="section-title" id="promote-title">{promoteInfo.title}</h2>
      <p class="section-copy">{promoteInfo.description}</p>
      <div class="promote-fact">
        <strong>Lieu</strong>
        <span>{promoteInfo.venue}</span>
      </div>
      <div class="promote-fact">
        <strong>Emplacement</strong>
        <span>{promoteInfo.boothStatus}</span>
      </div>
      <div class="hero-actions">
        <a class="button button-primary" href="#contact">Préparer ma visite</a>
      </div>
    </div>

    <div class="gallery-marquee" aria-label="Galerie du stand EREC">
      <div class="gallery-track">
        {
          marqueeImages.map((image, index) => (
            <figure class="gallery-item">
              <Image
                src={image}
                alt={index < promoteInfo.gallery.length ? 'Aperçu produit ou stand EREC' : ''}
                widths={[320, 520, 720]}
                sizes="(max-width: 700px) 70vw, 300px"
                loading="lazy"
              />
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>
