---
import {
  categoryLabels,
  contact,
  productRanges,
  products,
  salesDistributionNote,
  salesPointCategories,
  salesPoints,
} from '../data/site';

const normalizePhoneForLink = (phone: string) => {
  const cleaned = phone.trim().replace(/[^\d+]/g, '');
  if (cleaned.startsWith('+')) return cleaned;
  if (cleaned.startsWith('237') || cleaned.startsWith('225')) return `+${cleaned}`;
  if (cleaned.length === 9 && cleaned.startsWith('6')) return `+237${cleaned}`;
  return cleaned;
};

const phoneForWhatsApp = (phone: string) => normalizePhoneForLink(phone).replace(/[^\d]/g, '');

const groupedSalesPoints = salesPointCategories.map((category) => {
  const points = salesPoints.filter((point) => point.categories.includes(category.id));
  const cities = new Map<string, typeof points>();

  points.forEach((point) => {
    const key = point.country === 'Cameroun' ? point.city : point.country;
    cities.set(key, [...(cities.get(key) || []), point]);
  });

  return {
    ...category,
    cities: Array.from(cities, ([city, cityPoints]) => ({ city, points: cityPoints })),
  };
});

const groupedProducts = productRanges.map((range) => ({
  ...range,
  products: products.filter((product) => product.range === range.id),
}));
---

<section class="section" id="contact" aria-labelledby="contact-title">
  <div class="container contact-grid">
    <div>
      <span class="section-kicker">Contact</span>
      <h2 class="section-title" id="contact-title">Points de vente et demandes produits.</h2>
      <p class="section-copy">
        Passez en boutique, retrouvez EREC à PROMOTE 2026 ou envoyez une demande
        rapide sur WhatsApp.
      </p>

      <div class="sales-groups" aria-label="Points de vente">
        {
          groupedSalesPoints.map((category) => (
            <section class="sales-group" aria-labelledby={`sales-${category.id}`}>
              <div class="sales-group-head">
                <h3 id={`sales-${category.id}`}>{category.label}</h3>
                <p>{category.summary}</p>
              </div>
              <div class="sales-city-list">
                {category.cities.map(({ city, points }) => (
                  <section class="sales-city" aria-label={`Points de vente ${city}`}>
                    <h4>{city}</h4>
                    <div class="sales-list">
                      {points.map((point) => (
                        <article class="sales-card">
                          <div>
                            <h5>{point.name}</h5>
                            <p><strong>{point.address}</strong></p>
                            <p>{point.details}</p>
                          </div>
                          {point.phones.length > 0 && (
                            <div class="sales-phones" aria-label={`Contacts ${point.name}`}>
                              {point.phones.map((phone) => {
                                const linkPhone = normalizePhoneForLink(phone);
                                const whatsappPhone = phoneForWhatsApp(phone);
                                return (
                                  <span class="sales-phone">
                                    <a href={`tel:${linkPhone}`} aria-label={`Appeler ${phone}`}>
                                      {phone}
                                    </a>
                                    <a
                                      href={`https://wa.me/${whatsappPhone}`}
                                      target="_blank"
                                      rel="noopener noreferrer"
                                      aria-label={`Contacter ${phone} sur WhatsApp`}
                                    >
                                      WhatsApp
                                    </a>
                                  </span>
                                );
                              })}
                            </div>
                          )}
                        </article>
                      ))}
                    </div>
                  </section>
                ))}
              </div>
            </section>
          ))
        }
      </div>
      <p class="sales-distribution-note">{salesDistributionNote}</p>
    </div>

    <div class="contact-panel">
      <form class="contact-form" data-contact-form>
        <div class="form-row">
          <label for="contact-name">Nom</label>
          <input
            class="contact-field"
            id="contact-name"
            name="name"
            type="text"
            autocomplete="name"
            required
            placeholder="Votre nom"
          />
        </div>

        <div class="form-row">
          <span class="form-label" id="contact-products-label">Produits</span>
          <details class="product-picker" data-product-picker>
            <summary aria-labelledby="contact-products-label">
              <span data-product-summary>Choisir un ou plusieurs produits</span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="m6 9 6 6 6-6"
                  fill="none"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2.2"
                />
              </svg>
            </summary>

            <div class="product-picker-menu" role="group" aria-labelledby="contact-products-label">
              <div class="product-picker-toolbar">
                <button class="product-picker-clear" type="button" data-product-clear disabled>
                  Tout désélectionner
                </button>
              </div>
              {
                groupedProducts.map((range) => (
                  <section class="product-picker-group" aria-label={range.label}>
                    <h3>{range.label}</h3>
                    <div class="product-picker-options">
                      {range.products.map((product) => (
                        <label class="product-check">
                          <input type="checkbox" name="products" value={product.name} />
                          <span class="product-check-box" aria-hidden="true"></span>
                          <span>
                            <strong>{product.name}</strong>
                            <small>
                              {categoryLabels[product.category]}
                              {product.priceLabel ? ` - ${product.priceLabel}` : ''}
                            </small>
                          </span>
                        </label>
                      ))}
                    </div>
                  </section>
                ))
              }
            </div>
          </details>
          <div class="product-picker-selected" data-product-selected hidden></div>
          <p class="form-error" data-product-error hidden>
            Sélectionnez au moins un produit avant l'envoi.
          </p>
        </div>

        <div class="form-row">
          <label for="contact-message">Message facultatif</label>
          <textarea
            class="contact-textarea"
            id="contact-message"
            name="message"
            placeholder="Votre question, quantité souhaitée ou point de retrait"
          ></textarea>
        </div>

        <button class="button button-primary" type="submit">Envoyer sur WhatsApp</button>
      </form>
    </div>
  </div>
</section>

<script define:vars={{ phone: contact.phone }}>
  const form = document.querySelector('[data-contact-form]');

  if (form instanceof HTMLFormElement) {
    const picker = form.querySelector('[data-product-picker]');
    const pickerSummary = picker?.querySelector('summary');
    const productInputs = Array.from(form.querySelectorAll('input[name="products"]'));
    const productSummary = form.querySelector('[data-product-summary]');
    const selectedProductsPreview = form.querySelector('[data-product-selected]');
    const productError = form.querySelector('[data-product-error]');
    const clearProductsButton = form.querySelector('[data-product-clear]');

    const getSelectedProducts = () =>
      productInputs
        .filter((input) => input instanceof HTMLInputElement && input.checked)
        .map((input) => input.value.trim())
        .filter(Boolean);

    const updateProductSummary = () => {
      const selectedProducts = getSelectedProducts();

      if (productSummary) {
        productSummary.textContent =
          selectedProducts.length > 0
            ? `${selectedProducts.length} produit${selectedProducts.length > 1 ? 's' : ''} sélectionné${
                selectedProducts.length > 1 ? 's' : ''
              }`
            : 'Choisir un ou plusieurs produits';
      }

      if (selectedProductsPreview instanceof HTMLElement) {
        selectedProductsPreview.hidden = selectedProducts.length === 0;
        selectedProductsPreview.replaceChildren();

        selectedProducts.slice(0, 4).forEach((product) => {
          const tag = document.createElement('span');
          tag.textContent = product;
          selectedProductsPreview.append(tag);
        });

        if (selectedProducts.length > 4) {
          const moreTag = document.createElement('span');
          moreTag.textContent = `+${selectedProducts.length - 4}`;
          selectedProductsPreview.append(moreTag);
        }
      }

      if (productError instanceof HTMLElement && selectedProducts.length > 0) {
        productError.hidden = true;
      }

      if (clearProductsButton instanceof HTMLButtonElement) {
        clearProductsButton.disabled = selectedProducts.length === 0;
      }
    };

    productInputs.forEach((input) => {
      input.addEventListener('change', updateProductSummary);
    });

    clearProductsButton?.addEventListener('click', () => {
      productInputs.forEach((input) => {
        if (input instanceof HTMLInputElement) input.checked = false;
      });

      if (productError instanceof HTMLElement) productError.hidden = true;
      updateProductSummary();
    });

    document.addEventListener('click', (event) => {
      if (!(picker instanceof HTMLDetailsElement) || !picker.open) return;
      const target = event.target;
      if (target instanceof Node && !picker.contains(target)) {
        picker.open = false;
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && picker instanceof HTMLDetailsElement && picker.open) {
        picker.open = false;
        pickerSummary?.focus();
      }
    });

    updateProductSummary();

    form.addEventListener('submit', (event) => {
      event.preventDefault();

      const data = new FormData(form);
      const name = String(data.get('name') || '').trim();
      const selectedProducts = getSelectedProducts();
      const message = String(data.get('message') || '').trim();

      if (selectedProducts.length === 0) {
        if (productError instanceof HTMLElement) productError.hidden = false;
        if (picker instanceof HTMLDetailsElement) picker.open = true;
        pickerSummary?.focus();
        return;
      }

      const lines = [
        'Bonjour EREC CAMEROUN,',
        name ? `Je suis ${name}.` : '',
        selectedProducts.length === 1
          ? `Je souhaite des informations sur : ${selectedProducts[0]}.`
          : `Je souhaite des informations sur les produits/services suivants :\n${selectedProducts
              .map((product) => `- ${product}`)
              .join('\n')}`,
        message ? `Message : ${message}` : '',
      ].filter(Boolean);

      const url = `https://wa.me/${phone}?text=${encodeURIComponent(lines.join('\n'))}`;
      window.open(url, '_blank', 'noopener,noreferrer');
    });
  }
</script>
