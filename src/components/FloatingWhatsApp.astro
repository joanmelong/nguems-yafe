---
import { contact } from '../data/site';

const whatsappHref = `https://wa.me/${contact.phone}?text=${encodeURIComponent(
  contact.whatsappMessage
)}`;
---

<a
  class="floating-whatsapp"
  href={whatsappHref}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Contacter EREC CAMEROUN sur WhatsApp"
  data-floating-whatsapp
>
  <svg width="34" height="34" viewBox="0 0 24 24" aria-hidden="true">
    <path
      d="M19.05 4.91A9.82 9.82 0 0 0 12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.26-1.38a9.9 9.9 0 0 0 4.73 1.2h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.91-7Zm-7 15.24h-.01a8.23 8.23 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.23 8.23 0 0 1-1.26-4.38c0-4.55 3.7-8.25 8.26-8.25 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c-.01 4.55-3.71 8.24-8.24 8.24Zm4.52-6.17c-.25-.12-1.47-.73-1.7-.81-.23-.08-.39-.12-.56.12-.16.25-.64.81-.78.98-.14.16-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.48-1.39-1.73-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.16.04-.31-.02-.43-.06-.12-.56-1.35-.76-1.85-.2-.48-.4-.41-.56-.42h-.48c-.16 0-.43.06-.66.31-.23.25-.87.85-.87 2.07s.89 2.4 1.01 2.57c.12.16 1.75 2.67 4.24 3.74.59.25 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.08.14-1.18-.06-.1-.22-.16-.47-.29Z"
      fill="currentColor"
    />
  </svg>
</a>

<button
  class="floating-back-top"
  type="button"
  aria-label="Retourner en haut de page"
  data-floating-back-top
>
  <svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true">
    <path
      d="M12 19V5m0 0-6 6m6-6 6 6"
      fill="none"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2.4"
    />
  </svg>
</button>

<script>
  const button = document.querySelector('[data-floating-whatsapp]');
  const backTopButton = document.querySelector('[data-floating-back-top]');
  const contactPanel = document.querySelector('[data-contact-form]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (button && contactPanel && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        button.classList.toggle('is-hidden', entry.isIntersecting);
      },
      {
        threshold: 0.15,
      }
    );

    observer.observe(contactPanel);
  }

  if (backTopButton instanceof HTMLButtonElement) {
    const updateBackTopVisibility = () => {
      backTopButton.classList.toggle('is-visible', window.scrollY > 520);
    };

    backTopButton.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: reduceMotion.matches ? 'auto' : 'smooth',
      });
    });

    updateBackTopVisibility();
    window.addEventListener('scroll', updateBackTopVisibility, { passive: true });
  }
</script>
