---
import { Image } from 'astro:assets';
import { contact, heroVisual, siteMeta } from '../data/site';
import Lightfall from './Lightfall.astro';

const whatsappHref = `https://wa.me/${contact.phone}?text=${encodeURIComponent(
  contact.whatsappMessage
)}`;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-lightfall">
    <Lightfall
      colors={['#FBCE4D', '#01A101', '#FFFFFF']}
      backgroundColor="#031507"
      speed={0.5}
      streakCount={24}
      streakWidth={1}
      streakLength={1.2}
      glow={1}
      density={0.8}
      twinkle={1}
      zoom={3}
      backgroundGlow={0.85}
      opacity={1}
      mouseInteraction
      mouseStrength={0.5}
      mouseRadius={1}
      color1="#FBCE4D"
      color2="#01A101"
      color3="#FFFFFF"
    />
  </div>

  <div class="container hero-inner">
    <div class="hero-content fade-up">
      <span class="section-kicker hero-kicker">PROMOTE 2026 - Yaoundé</span>
      <p></p>
      <h1 class="section-heading" id="hero-title">{siteMeta.brand}</h1>
      <p class="section-copy">{siteMeta.subtitle}</p>
      <p class="section-copy">
        Découvrez nos gammes beauté, bien-être et packaging dans un espace pensé
        pour les clientes, revendeurs et partenaires.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#produits">Découvrir les produits</a>
        <a class="button button-secondary" href={whatsappHref} target="_blank" rel="noopener noreferrer">
          Ecrire sur WhatsApp
        </a>
      </div>
    </div>

    <div class="hero-product-stack">
      <div class="hero-product hero-product-main">
        <Image
          src={heroVisual.image}
          alt={heroVisual.alt}
          widths={[420, 640, 860, 1080]}
          sizes="(max-width: 700px) 92vw, (max-width: 1024px) 62vw, 500px"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>
