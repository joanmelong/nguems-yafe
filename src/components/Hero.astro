---
import { Image } from 'astro:assets';
import { contact, products, siteMeta } from '../data/site';

const heroImages = products.slice(0, 4).map((product) => product.image);
const whatsappHref = `https://wa.me/${contact.phone}?text=${encodeURIComponent(
  contact.whatsappMessage
)}`;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-gallery" aria-hidden="true">
    {
      heroImages.map((image, index) => (
        <div class="hero-gallery-card">
          <Image
            src={image}
            alt=""
            widths={[360, 520, 720]}
            sizes="25vw"
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'auto'}
          />
        </div>
      ))
    }
  </div>

  <div class="container hero-inner">
    <div class="hero-content fade-up">
      <span class="section-kicker">PROMOTE 2026 - Yaoundé</span>
      <h1 class="section-heading" id="hero-title">{siteMeta.brand}</h1>
      <p class="section-copy">{siteMeta.subtitle}</p>
      <p class="section-copy">
        Découvrez nos gammes beauté, bien-être et packaging dans un espace pensé
        pour les clientes, revendeurs et partenaires.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#produits">Découvrir les produits</a>
        <a class="button button-secondary" href={whatsappHref} target="_blank" rel="noopener noreferrer">
          Ecrire sur WhatsApp
        </a>
      </div>
    </div>

    <div class="hero-product-stack" aria-hidden="true">
      <div class="hero-product hero-product-primary">
        <Image
          src={products[0].image}
          alt=""
          widths={[360, 540, 720]}
          sizes="(max-width: 700px) 78vw, 380px"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="hero-product hero-product-secondary">
        <Image
          src={products[1].image}
          alt=""
          widths={[260, 420]}
          sizes="(max-width: 700px) 55vw, 250px"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>
