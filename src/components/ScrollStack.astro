---
interface Props {
  label?: string;
  itemDistance?: number;
  itemStackDistance?: number;
}

const {
  label = 'Valeurs et offres EREC',
  itemDistance = 52,
  itemStackDistance = 22,
} = Astro.props;

const stackStyle = `--stack-item-distance: ${itemDistance}px; --stack-item-offset: ${itemStackDistance}px;`;
---

<div
  class="scroll-stack-scroller"
  aria-label={label}
  tabindex="0"
  style={stackStyle}
>
  <div class="scroll-stack-inner">
    <slot />
    <div class="scroll-stack-end" aria-hidden="true"></div>
  </div>
</div>
